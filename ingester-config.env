sudo cat << 'EOF' > /etc/volcano-ingester/config.env
# Database Connection Settings
DB_HOST=10.250.3.15
DB_PORT=5432
DB_NAME=volcano
DB_USER=logstash_ro
DB_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
DB_SSLMODE=prefer
DB_SCHEMA=investigations
DB_TABLE=analyses

# Logstash HTTP Input
LOGSTASH_URL=http://localhost:5666
LOGSTASH_TIMEOUT=30

# State and History Tracking
STATE_FILE_PATH=/var/lib/volcano-ingester/ingestion_state.json
HISTORY_FILE_PATH=/var/lib/volcano-ingester/processed_analyses.ndjson


POLL_INTERVAL_SECONDS=60

DISPATCH_SLEEP_SECONDS=90

# Initial Run / Historic Ingestion Settings
# Set to earliest epoch for full historical backfill, or specify a start date (ISO 8601)
INITIAL_DATE=2000-01-01T00:00:00+00:00
EOF